{
  "name": "termo",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --progress=false --configuration production --aot",
    "get-stats": "npm run build -- --stats-json",
    "bundle-analyze": "esbuild-visualizer --metadata dist/stats.json",
    "envsub": "envsub",
    "sentry-release": "sh ./bin/sentry-release.sh",
    "e2e-setup": "playwright install",
    "e2e": "ng e2e",
    "e2e:ci": "playwright test",
    "deploy": "npm run build && npm run post-deploy",
    "post-deploy": "envsub ./dist/browser/index.html && envsub netlify.toml.template netlify.toml && npm run sentry-release",
    "lint": "ng lint",
    "test": "NODE_OPTIONS=\"--max-old-space-size=4096\" ng test --no-watch",
    "test:file": "ng test --no-watch --include",
    "test:watch": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.6",
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/platform-browser": "^22.0.6",
    "@angular/platform-browser-dynamic": "^22.0.6",
    "@angular/router": "^22.0.6",
    "@glitchtip/ng-charts": "^1.3.0",
    "@ngneat/overview": "^7.0.0",
    "@ngxpert/hot-toast": "^6.2.0",
    "@sentry/browser": "^10.15.0",
    "backoff-rxjs": "^7.0.0",
    "date-fns": "^4.1.0",
    "ms": "^3.0.0 || ^3.0.0-canary.1",
    "normalize.css": "^8.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.0.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.5",
    "@angular-eslint/builder": "22.0.0",
    "@angular-eslint/eslint-plugin": "22.0.0",
    "@angular-eslint/eslint-plugin-template": "22.0.0",
    "@angular-eslint/schematics": "22.0.0",
    "@angular-eslint/template-parser": "22.0.0",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.6",
    "@granito/vitest-marbles": "^1.1.2",
    "@playwright/test": "1.55.1",
    "@sentry/cli": "^2.55.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/ms": "^2.1.0",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@typescript-eslint/types": "^8.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "angular-eslint": "^22.0.0",
    "envsub": "^4.1.0",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^9.28.0",
    "jsdom": "^26.1.0",
    "playwright-ng-schematics": "^2.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
